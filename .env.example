# Copy to .env and fill in. All three are required — `npm run build` fails without them.
# They are inlined into the browser bundle at build time, so use public/anon keys only.

VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<supabase anon key>

# Mapbox public token (pk.*) — powers the address autocomplete when adding or
# editing a property. Without it the build fails; before that guard existed, a
# build without it shipped with the address search silently doing nothing.
VITE_MAPBOX_TOKEN=pk.<mapbox public token>
